{
  "name": "my-pi-setup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal global Pi setup with custom extensions, themes, and pinned third-party packages.",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:agent-teams-runtime": "node --experimental-strip-types tests/agent-teams-runtime-probe.mjs"
  },
  "dependencies": {
    "@juicesharp/rpiv-ask-user-question": "^2.7.0",
    "@plannotator/pi-extension": "^0.27.6",
    "typebox": "^1.3.11"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/worker-mode.ts",
      "./extensions/dependency-update-notifier.ts",
      "./extensions/herdr-integration.ts",
      "./extensions/guardrails.ts",
      "./extensions/steering-choice.ts",
      "./node_modules/@juicesharp/rpiv-ask-user-question/index.ts",
      "./node_modules/@plannotator/pi-extension/index.ts",
      "./extensions/planning-workflow.ts",
      "./extensions/orchestration.ts"
    ],
    "themes": [
      "./themes"
    ],
    "skills": [
      "./skills"
    ]
  }
}
