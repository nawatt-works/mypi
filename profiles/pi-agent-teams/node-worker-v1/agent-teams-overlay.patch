+export function buildTeammateEnvironment(
+	parent: NodeJS.ProcessEnv,
+	overrides: Record<string, string>,
+): NodeJS.ProcessEnv {
+	const child: NodeJS.ProcessEnv = {};
+	for (const [key, value] of Object.entries(parent)) {
+		if (value === undefined) continue;
+		if (CHILD_ENV_ALLOWLIST.has(key) || key.startsWith("LC_")) child[key] = value;
+	}
+	for (const [key, value] of Object.entries(overrides)) child[key] = value;
+	return child;
